# Copy to .env and fill in. .env is gitignored — never commit real values.

# Flickr API credentials, from https://www.flickr.com/services/apps/create/
FLICKR_API_KEY=
FLICKR_API_SECRET=

# Directory scanned for photos to upload. Kept here rather than in
# run_upload.sh because the path embeds the local username and cloud account
# name, and this repo is public. Images must sit in a subfolder of this
# directory — anything at the top level is ignored by the scanner.
PHOTOS_DIR="/Users/you/Library/CloudStorage/GoogleDrive-you@example.com/My Drive/Photos2026"
